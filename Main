<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reparaciones Carbone IT</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script crossorigin src="https://unpkg.com/react@18/umd/react.development.js"></script>
  <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    :root { color-scheme: dark; }
    * { box-sizing: border-box; }
    body { margin: 0; background: #08111f; color: #e6edf5; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    button, input, select, textarea { font: inherit; }
    button { cursor: pointer; }
    .app-shell { background: radial-gradient(circle at 85% 0%, rgba(14, 165, 233, .13), transparent 30rem), linear-gradient(145deg, #08111f 0%, #0b1727 55%, #101827 100%); min-height: 100vh; }
    .panel { background: rgba(15, 29, 48, .82); border: 1px solid rgba(148, 163, 184, .15); box-shadow: 0 20px 60px rgba(0, 0, 0, .18); }
    .field { width: 100%; border: 1px solid #293b52; background: #101f33; color: #e6edf5; border-radius: .65rem; padding: .72rem .85rem; outline: none; transition: border-color .2s, box-shadow .2s; }
    .field:focus { border-color: #38bdf8; box-shadow: 0 0 0 3px rgba(56, 189, 248, .14); }
    .field::placeholder { color: #71839a; }
    .tab-active { color: #67e8f9; border-color: #22d3ee; background: rgba(34, 211, 238, .08); }
    .tab { border-bottom: 2px solid transparent; color: #91a4b9; transition: .2s; }
    .tab:hover { color: #e6edf5; background: rgba(148, 163, 184, .07); }
    .status { border-radius: 999px; padding: .25rem .6rem; font-size: .75rem; font-weight: 700; white-space: nowrap; }
    .status-pending { color: #fcd34d; background: rgba(245, 158, 11, .14); }
    .status-in_progress { color: #7dd3fc; background: rgba(14, 165, 233, .14); }
    .status-completed { color: #86efac; background: rgba(34, 197, 94, .14); }
    .status-delivered { color: #c4b5fd; background: rgba(139, 92, 246, .14); }
    .fade-in { animation: fade-in .35s ease both; }
    @keyframes fade-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
    @media (max-width: 640px) { .mobile-stack { flex-direction: column; align-items: stretch; } }
  </style>
</head>
<body>
  <div id="root"></div>
  <script type="text/babel">
    const { useEffect, useMemo, useState } = React;

    // Sustituye estos valores por los de tu proyecto Supabase.
    // Usa únicamente la clave pública anon, nunca la service_role.
    const SUPABASE_URL = "https://tyocvizwjdcmewiqjodv.supabase.co";
    const SUPABASE_ANON_KEY = "sb_publishable_d_oar3YKMFlf3pAD4qRzSQ_eiQdr8-u";
    const supabaseReady = SUPABASE_URL.startsWith("https://") && !SUPABASE_URL.includes("TU_") && !SUPABASE_ANON_KEY.includes("TU_");
    const supabase = supabaseReady ? window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY) : null;
    const STORAGE_KEY = "techrepair-storage-v1";

    const STATUS_LABELS = { pending: "Pendiente", in_progress: "En proceso", completed: "Completada", delivered: "Entregada" };
    const DEVICE_LABELS = { laptop: "Portátil", desktop: "Sobremesa", phone: "Móvil", tablet: "Tableta", printer: "Impresora", network: "Red", other: "Otro" };
    const emptyRepair = { department: "", deviceType: "laptop", brand: "", model: "", serialNumber: "", problemDescription: "", repairTypes: [], diagnosis: "", solution: "", entryDate: new Date().toISOString().slice(0, 10), deliveryDate: "", notes: "", status: "pending" };

    const id = () => crypto.randomUUID ? crypto.randomUUID() : `${Date.now()}-${Math.random().toString(16).slice(2)}`;
    const toLocal = (row) => ({ id: row.id, department: row.department || "", deviceType: row.device_type || "other", brand: row.brand || "", model: row.model || "", serialNumber: row.serial_number || "", problemDescription: row.problem_description || "", repairTypes: row.repair_types || [], diagnosis: row.diagnosis || "", solution: row.solution || "", entryDate: row.entry_date || "", deliveryDate: row.delivery_date || "", notes: row.notes || "", status: row.status || "pending", createdAt: row.created_at || new Date().toISOString(), updatedAt: row.updated_at || row.created_at || new Date().toISOString(), deleted: row.deleted || false });
    const toCloud = (repair) => ({ id: repair.id, department: repair.department, device_type: repair.deviceType, brand: repair.brand, model: repair.model, serial_number: repair.serialNumber, problem_description: repair.problemDescription, repair_types: repair.repairTypes, diagnosis: repair.diagnosis, solution: repair.solution, entry_date: repair.entryDate || null, delivery_date: repair.deliveryDate || null, notes: repair.notes, status: repair.status, created_at: repair.createdAt, updated_at: repair.updatedAt, deleted: !!repair.deleted });

    function useRepairs() {
      const [repairs, setRepairs] = useState(() => { try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]"); } catch { return []; } });
      const [hydrated, setHydrated] = useState(false);
      const [syncing, setSyncing] = useState(false);
      const [lastSynced, setLastSynced] = useState(null);
      const persist = (next) => { setRepairs(next); localStorage.setItem(STORAGE_KEY, JSON.stringify(next)); };

      const syncWithCloud = async () => {
        if (!supabase) return;
        setSyncing(true);
        try {
          const { data, error } = await supabase.from("repairs").select("*").order("created_at", { ascending: false });
          if (error) throw error;
          const cloud = (data || []).map(toLocal);
          setRepairs(current => {
            const byId = new Map(current.map(item => [item.id, item]));
            cloud.forEach(item => byId.set(item.id, item));
            const merged = [...byId.values()].sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
            localStorage.setItem(STORAGE_KEY, JSON.stringify(merged));
            return merged;
          });
          setLastSynced(new Date());
        } catch (error) {
          console.error("Supabase sync error:", error);
          const fileOriginHint = window.location.protocol === "file:" ? " Abre este HTML mediante un servidor local (por ejemplo, Live Server), no con file://." : "";
          alert(`No se pudo sincronizar: ${error.message}.${fileOriginHint}`);
        }
        finally { setSyncing(false); }
      };

      const saveCloud = async (repair) => {
        if (!supabase) return;
        const { error } = await supabase.from("repairs").upsert(toCloud(repair), { onConflict: "id" });
        if (error) throw error;
      };
      const addRepair = async (data) => { const repair = { ...data, id: id(), createdAt: new Date().toISOString(), updatedAt: new Date().toISOString(), deleted: false }; persist([repair, ...repairs]); await saveCloud(repair); return repair; };
      const updateRepair = async (repairId, data) => { const updated = { ...repairs.find(item => item.id === repairId), ...data, id: repairId, updatedAt: new Date().toISOString() }; persist(repairs.map(item => item.id === repairId ? updated : item)); await saveCloud(updated); };
      const deleteRepair = async (repairId) => { const updated = { ...repairs.find(item => item.id === repairId), deleted: true, updatedAt: new Date().toISOString() }; persist(repairs.map(item => item.id === repairId ? updated : item)); await saveCloud(updated); };
      useEffect(() => { setHydrated(true); if (supabase) syncWithCloud(); }, []);
      return { repairs, hydrated, syncing, lastSynced, syncWithCloud, addRepair, updateRepair, deleteRepair };
    }

    function Field({ label, children, required }) { return <label className="block"><span className="mb-2 block text-sm font-medium text-slate-300">{label}{required && <b className="ml-1 text-cyan-300">*</b>}</span>{children}</label>; }
    function Button({ children, onClick, type = "button", secondary = false, disabled = false }) { return <button type={type} onClick={onClick} disabled={disabled} className={`rounded-lg px-4 py-2.5 text-sm font-semibold transition disabled:cursor-not-allowed disabled:opacity-50 ${secondary ? "border border-slate-600 bg-slate-800 text-slate-200 hover:bg-slate-700" : "bg-cyan-400 text-slate-950 hover:bg-cyan-300"}`}>{children}</button>; }

    function RepairForm({ initial = emptyRepair, onSubmit, onCancel, busy }) {
      const [form, setForm] = useState({ ...emptyRepair, ...initial, repairTypes: initial.repairTypes || [] });
      const repairOptions = ["Hardware", "Software", "Limpieza", "Red", "Recuperación de datos"];
      const change = event => setForm(prev => ({ ...prev, [event.target.name]: event.target.value }));
      const toggleType = type => setForm(prev => ({ ...prev, repairTypes: prev.repairTypes.includes(type) ? prev.repairTypes.filter(item => item !== type) : [...prev.repairTypes, type] }));
      const submit = event => { event.preventDefault(); if (!form.department || !form.model || !form.problemDescription) return alert("Completa departamento, modelo y descripción del problema."); onSubmit(form); };
      return <form onSubmit={submit} className="panel fade-in space-y-6 rounded-2xl p-5 sm:p-7">
        <div><h2 className="text-xl font-bold text-white">{initial.id ? "Editar reparación" : "Nueva reparación"}</h2><p className="mt-1 text-sm text-slate-400">Registra el equipo y deja trazabilidad del trabajo técnico.</p></div>
        <div className="grid gap-4 sm:grid-cols-2">
          <Field label="Departamento" required><input className="field" name="department" value={form.department} onChange={change} placeholder="Administración" /></Field>
          <Field label="Tipo de dispositivo"><select className="field" name="deviceType" value={form.deviceType} onChange={change}>{Object.entries(DEVICE_LABELS).map(([value, label]) => <option value={value} key={value}>{label}</option>)}</select></Field>
          <Field label="Marca"><input className="field" name="brand" value={form.brand} onChange={change} placeholder="Dell, HP, Apple..." /></Field>
          <Field label="Modelo" required><input className="field" name="model" value={form.model} onChange={change} placeholder="Latitude 5420" /></Field>
          <Field label="Número de serie"><input className="field" name="serialNumber" value={form.serialNumber} onChange={change} placeholder="SN-000000" /></Field>
          <Field label="Estado"><select className="field" name="status" value={form.status} onChange={change}>{Object.entries(STATUS_LABELS).map(([value, label]) => <option value={value} key={value}>{label}</option>)}</select></Field>
          <Field label="Fecha de entrada"><input className="field" type="date" name="entryDate" value={form.entryDate} onChange={change} /></Field>
          <Field label="Fecha de entrega"><input className="field" type="date" name="deliveryDate" value={form.deliveryDate} onChange={change} /></Field>
        </div>
        <Field label="Descripción del problema" required><textarea className="field min-h-24 resize-y" name="problemDescription" value={form.problemDescription} onChange={change} placeholder="Describe el fallo reportado..." /></Field>
        <div><span className="mb-2 block text-sm font-medium text-slate-300">Tipos de reparación</span><div className="flex flex-wrap gap-2">{repairOptions.map(type => <button type="button" key={type} onClick={() => toggleType(type)} className={`rounded-full border px-3 py-1.5 text-sm transition ${form.repairTypes.includes(type) ? "border-cyan-300 bg-cyan-300/15 text-cyan-200" : "border-slate-600 text-slate-400 hover:border-slate-400"}`}>{type}</button>)}</div></div>
        <div className="grid gap-4 sm:grid-cols-2"><Field label="Diagnóstico"><textarea className="field min-h-28 resize-y" name="diagnosis" value={form.diagnosis} onChange={change} /></Field><Field label="Solución aplicada"><textarea className="field min-h-28 resize-y" name="solution" value={form.solution} onChange={change} /></Field></div>
        <Field label="Notas internas"><textarea className="field min-h-20 resize-y" name="notes" value={form.notes} onChange={change} placeholder="Notas visibles para el equipo técnico..." /></Field>
        <div className="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">{onCancel && <Button secondary onClick={onCancel}>Cancelar</Button>}<Button type="submit" disabled={busy}>{busy ? "Guardando..." : initial.id ? "Guardar cambios" : "Registrar reparación"}</Button></div>
      </form>;
    }

    function History({ repairs, onEdit, onDelete, onDuplicate }) {
      const [search, setSearch] = useState(""); const [status, setStatus] = useState("all"); const [device, setDevice] = useState("all");
      const filtered = repairs.filter(item => { const haystack = `${item.department} ${item.model} ${item.brand} ${item.serialNumber} ${item.problemDescription}`.toLowerCase(); return haystack.includes(search.toLowerCase()) && (status === "all" || item.status === status) && (device === "all" || item.deviceType === device); });
      return <div className="space-y-5 fade-in"><div className="panel grid gap-3 rounded-2xl p-4 md:grid-cols-[1fr_180px_180px]"><input className="field" value={search} onChange={e => setSearch(e.target.value)} placeholder="Buscar por equipo, marca, departamento..." /><select className="field" value={status} onChange={e => setStatus(e.target.value)}><option value="all">Todos los estados</option>{Object.entries(STATUS_LABELS).map(([value, label]) => <option key={value} value={value}>{label}</option>)}</select><select className="field" value={device} onChange={e => setDevice(e.target.value)}><option value="all">Todos los dispositivos</option>{Object.entries(DEVICE_LABELS).map(([value, label]) => <option key={value} value={value}>{label}</option>)}</select></div>{filtered.length === 0 ? <div className="panel rounded-2xl p-12 text-center"><div className="text-4xl">⌕</div><h3 className="mt-3 font-semibold text-white">No hay reparaciones</h3><p className="mt-1 text-sm text-slate-400">Cambia los filtros o registra una nueva reparación.</p></div> : <div className="grid gap-4">{filtered.map(item => <article className="panel rounded-2xl p-5" key={item.id}><div className="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between"><div><div className="flex flex-wrap items-center gap-2"><h3 className="text-lg font-bold text-white">{item.brand} {item.model}</h3><span className={`status status-${item.status}`}>{STATUS_LABELS[item.status]}</span></div><p className="mt-1 text-sm text-slate-400">{DEVICE_LABELS[item.deviceType]} · {item.department} · {item.serialNumber || "Sin número de serie"}</p></div><span className="text-xs text-slate-500">{item.entryDate || "Sin fecha"}</span></div><p className="mt-4 text-sm leading-6 text-slate-300">{item.problemDescription}</p>{(item.diagnosis || item.solution) && <div className="mt-4 grid gap-3 border-t border-slate-700 pt-4 text-sm sm:grid-cols-2"><div><div className="text-xs uppercase tracking-wider text-slate-500">Diagnóstico</div><p className="mt-1 text-slate-300">{item.diagnosis || "Pendiente"}</p></div><div><div className="text-xs uppercase tracking-wider text-slate-500">Solución</div><p className="mt-1 text-slate-300">{item.solution || "Pendiente"}</p></div></div>}<div className="mt-5 flex flex-wrap gap-2"><Button secondary onClick={() => onEdit(item)}>Editar</Button><Button secondary onClick={() => onDuplicate(item)}>Duplicar</Button><button className="rounded-lg px-3 py-2 text-sm text-rose-300 hover:bg-rose-400/10" onClick={() => onDelete(item.id)}>Eliminar</button></div></article>)}</div>}</div>;
    }

    function Stats({ repairs }) { const month = new Date(); const thisMonth = repairs.filter(item => { const date = new Date(item.createdAt); return date.getMonth() === month.getMonth() && date.getFullYear() === month.getFullYear(); }).length; const active = repairs.filter(item => ["pending", "in_progress"].includes(item.status)).length; const completed = repairs.filter(item => ["completed", "delivered"].includes(item.status)).length; const counts = key => Object.entries(repairs.reduce((all, item) => ({ ...all, [item[key]]: (all[item[key]] || 0) + 1 }), {})).sort((a, b) => b[1] - a[1]); return <div className="space-y-5 fade-in"><div className="grid gap-4 sm:grid-cols-3">{[["Total", repairs.length, "text-white"], ["Este mes", thisMonth, "text-cyan-300"], ["En proceso", active, "text-amber-300"], ["Completadas", completed, "text-emerald-300"]].map(([label, value, color]) => <div className="panel rounded-2xl p-5" key={label}><p className="text-sm text-slate-400">{label}</p><p className={`mt-2 text-3xl font-bold ${color}`}>{value}</p></div>)}</div><div className="grid gap-5 md:grid-cols-2"><StatGroup title="Por estado" entries={counts("status")} labels={STATUS_LABELS} /><StatGroup title="Por dispositivo" entries={counts("deviceType")} labels={DEVICE_LABELS} /></div></div>; }
    function StatGroup({ title, entries, labels }) { const max = entries[0]?.[1] || 1; return <div className="panel rounded-2xl p-5"><h3 className="font-semibold text-white">{title}</h3><div className="mt-5 space-y-4">{entries.length ? entries.map(([key, value]) => <div key={key}><div className="mb-1 flex justify-between text-sm"><span className="text-slate-300">{labels[key] || key}</span><span className="text-slate-500">{value}</span></div><div className="h-2 overflow-hidden rounded-full bg-slate-800"><div className="h-full rounded-full bg-cyan-400 transition-all" style={{ width: `${Math.max(8, value / max * 100)}%` }} /></div></div>) : <p className="text-sm text-slate-500">Todavía no hay datos.</p>}</div></div>; }

    function App() {
      const store = useRepairs(); const [view, setView] = useState("history"); const [editing, setEditing] = useState(null); const [busy, setBusy] = useState(false); const visible = store.repairs.filter(item => !item.deleted);
      const save = async data => { setBusy(true); try { if (editing) await store.updateRepair(editing.id, data); else await store.addRepair(data); setEditing(null); setView("history"); } catch (error) { alert(`No se pudo guardar: ${error.message}`); } finally { setBusy(false); } };
      const remove = async repairId => { if (!confirm("¿Eliminar esta reparación?")) return; try { await store.deleteRepair(repairId); } catch (error) { alert(`No se pudo eliminar: ${error.message}`); } };
      const duplicate = item => { setEditing({ ...item, id: undefined, createdAt: undefined, updatedAt: undefined, serialNumber: "", status: "in_progress", entryDate: new Date().toISOString().slice(0, 10) }); setView("new"); };
      if (!store.hydrated) return <div className="app-shell flex min-h-screen items-center justify-center"><div className="text-center"><div className="mx-auto h-10 w-10 animate-spin rounded-full border-2 border-cyan-300 border-t-transparent" /><p className="mt-4 text-sm text-slate-400">Cargando reparaciones...</p></div></div>;
      return <div className="app-shell"><header className="sticky top-0 z-10 border-b border-slate-700/60 bg-[#0b1727]/90 backdrop-blur"><div className="mx-auto max-w-7xl px-4 py-4 sm:px-6"><div className="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"><div><h1 className="text-xl font-bold tracking-tight text-white">Reparaciones Carbone IT</h1><p className="text-sm text-slate-400">Sistema de gestión de reparaciones</p></div><div className="flex items-center gap-3"><span className={`text-xs ${supabase ? "text-emerald-300" : "text-amber-300"}`}>{supabase ? "● Supabase conectado" : "● Modo local"}</span><Button secondary onClick={store.syncWithCloud} disabled={!supabase || store.syncing}>{store.syncing ? "Sincronizando..." : "Sincronizar"}</Button></div></div></div></header><main className="mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-8"><div className="mb-6 grid grid-cols-3 gap-2 rounded-xl border border-slate-700/60 bg-slate-900/40 p-1"><button className={`tab rounded-lg px-2 py-3 text-sm font-semibold sm:px-4 ${view === "new" ? "tab-active" : ""}`} onClick={() => { setEditing(null); setView("new"); }}>＋ <span className="hidden sm:inline">Nueva</span></button><button className={`tab rounded-lg px-2 py-3 text-sm font-semibold sm:px-4 ${view === "history" ? "tab-active" : ""}`} onClick={() => setView("history")}>▤ <span className="hidden sm:inline">Historial</span> <span className="ml-1 rounded-full bg-slate-700 px-2 py-0.5 text-xs">{visible.length}</span></button><button className={`tab rounded-lg px-2 py-3 text-sm font-semibold sm:px-4 ${view === "stats" ? "tab-active" : ""}`} onClick={() => setView("stats")}>▥ <span className="hidden sm:inline">Estadísticas</span></button></div>{view === "new" && <RepairForm initial={editing || emptyRepair} onSubmit={save} onCancel={editing ? () => { setEditing(null); setView("history"); } : null} busy={busy} />}{view === "history" && <History repairs={visible} onEdit={item => { setEditing(item); setView("new"); }} onDelete={remove} onDuplicate={duplicate} />}{view === "stats" && <Stats repairs={visible} />}</main><footer className="mx-auto max-w-7xl px-4 pb-8 text-xs text-slate-500 sm:px-6">{store.lastSynced ? `Última sincronización: ${store.lastSynced.toLocaleString()}` : supabase ? "Pendiente de sincronización" : "Los datos se guardan en este navegador"}</footer></div>;
    }
    ReactDOM.createRoot(document.getElementById("root")).render(<App />);
  </script>
</body>
</html>
